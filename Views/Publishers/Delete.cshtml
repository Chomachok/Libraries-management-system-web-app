@model LibrariesWebApp.Models.Publisher

@{
    ViewData["Title"] = "Удаление издательства";
}

<h2>@ViewData["Title"]</h2>

<h3>Вы уверены, что хотите удалить это издательство?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Город</dt>
        <dd class="col-sm-10">@Model.City</dd>

        <!-- Добавьте другие поля, если необходимо -->
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PublisherId" />
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>