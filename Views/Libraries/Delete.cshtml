@model LibrariesWebApp.Models.Library

@{
    ViewData["Title"] = "Удаление библиотеки";
}

<h2>@ViewData["Title"]</h2>

<h3>Вы уверены, что хотите удалить эту библиотеку?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Адрес</dt>
        <dd class="col-sm-10">@Model.Address</dd>

        <dt class="col-sm-2">Телефон</dt>
        <dd class="col-sm-10">@Model.Phone</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="LibraryId" />
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>