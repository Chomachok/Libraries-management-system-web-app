@model IEnumerable<LibrariesWebApp.Models.Library>

@{
    ViewData["Title"] = "Libraries";
}

<h2>@ViewData["Title"]</h2>

<body>
    @foreach (var library in Model)
    {
        <tr>
            <td>@library.LibraryId</td>
            <td>@library.Name</td>
            <td>@library.Address</td>
            <td>@library.Phone</td>
        </tr>
    }
</body>