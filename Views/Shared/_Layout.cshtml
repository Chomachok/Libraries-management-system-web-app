<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Библиотеки и книги</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz@14..32&family=IBM+Plex+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
<header class="header">
    <div class="container">
        <a href="@Url.Action("Index", "Home")" class="logo">
            <span class="logo-mark">📚</span>
            <span class="logo-text">Книжная полка</span>
        </a>
        <nav class="nav">
            <a href="@Url.Action("Index", "Libraries")" class="nav-item">Библиотеки</a>
            <a href="@Url.Action("Index", "Books")" class="nav-item">Книги</a>
            <a href="@Url.Action("Search", "Home")" class="nav-item">Поиск</a>
            <a href="@Url.Action("About", "Home")" class="nav-item">О проекте</a>
        </nav>
    </div>
</header>

<main class="main">
    <div class="container">
        @RenderBody()
    </div>
</main>

<footer class="footer">
    <div class="container">
        <span>© @DateTime.Now.Year — Книжная полка. Каталог библиотек и книг.</span>
        <small>v 1.0</small>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@RenderSection("Scripts", required: false)
</body>
</html>